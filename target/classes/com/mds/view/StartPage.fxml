<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="844.0" prefWidth="390.0" styleClass="app-root" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mds.controller.StartController">
   <children>
      <!-- Decorative Background Elements (Non-interactive) -->
      <Circle centerX="60.0" centerY="80.0" mouseTransparent="true" radius="130.0" styleClass="decorative-blob-1" />
      <Circle centerX="340.0" centerY="200.0" mouseTransparent="true" radius="95.0" styleClass="decorative-blob-2" />
      <Circle centerX="30.0" centerY="720.0" mouseTransparent="true" radius="110.0" styleClass="decorative-blob-2" />
      <Circle centerX="360.0" centerY="680.0" mouseTransparent="true" radius="140.0" styleClass="decorative-blob-1" />
      <Circle centerX="200.0" centerY="420.0" mouseTransparent="true" radius="170.0" styleClass="decorative-blob-3" />

      <!-- Main Center Content -->
      <VBox fx:id="mainContainer" alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="36.0" left="26.0" right="26.0" top="42.0" />
         </padding>
         <children>

            <!-- Flexible Space -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Elevated Logo Emblem -->
            <StackPane prefHeight="136.0" prefWidth="136.0">
               <children>
                  <!-- Outer orbital ring -->
                  <Circle radius="66.0" styleClass="ring-decoration" />
                  <!-- Middle soft sage aura -->
                  <Circle fill="#DDE7D8" opacity="0.6" radius="54.0" />
                  <!-- Core primary emblem -->
                  <Circle fill="#9CAF88" radius="46.0" />
                  <!-- Acronym -->
                  <Label style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-text-fill: #FFFFFF; -fx-letter-spacing: 1.5px;" text="MDS" />
               </children>
            </StackPane>

            <!-- Brand Titles and Tagline -->
            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label styleClass="brand-title" text="MDS" />
                  <Label styleClass="brand-tagline" text="Medical Diagnosis System" />
                  <Label styleClass="brand-description" text="Intelligent symptom-based health information&#10;and educational guidance assistant" textAlignment="CENTER" wrapText="true">
                     <VBox.margin>
                        <Insets top="4.0" />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>

            <!-- Feature Value Proposition Chips -->
            <HBox alignment="CENTER" spacing="8.0">
               <VBox.margin>
                  <Insets top="8.0" />
               </VBox.margin>
            </HBox>

            <!-- Flexible Middle Space -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Login Action Area -->
            <VBox alignment="CENTER" maxWidth="320.0" spacing="12.0">
               <children>
                  <Button fx:id="btnLogin" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                          onAction="#handleLogin"
                          onMousePressed="#onLoginPressed" onMouseReleased="#onLoginReleased"
                          prefHeight="50.0" styleClass="primary-button" text="Get Started  →" />
                  <Label styleClass="helper-text" text="Educational Prototype • Sign in to explore" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
